# ============================================================================
# iamhear userbot agent — systemd service (LS_Python source, run at /root/tgpro)
#
# Install:
#   cp /root/tgpro/tgpro.service /etc/systemd/system/tgpro.service
#   systemctl daemon-reload
#   systemctl enable --now tgpro
#
# This runs the SUPERVISOR (multi-shard, self-healing). For a small setup you
# can change agent.supervisor -> agent.worker in ExecStart below.
# ============================================================================
[Unit]
Description=iamhear Telegram userbot agent (tgpro)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tgpro

# Python that has the deps installed. Must match where you ran
#   /usr/bin/python3.12 -m pip install -r requirements.txt
# If you use a virtualenv instead, change this to /root/tgpro/.venv/bin/python
ExecStart=/usr/bin/python3.12 -m agent.supervisor

# Ensure root's user site-packages are visible under systemd too.
Environment=HOME=/root

# --- Auto-restart / 24-7 ---
Restart=always
RestartSec=3
# Never give up restarting, even after repeated fast crashes.
StartLimitIntervalSec=0

# Logs go to the journal (view with: journalctl -u tgpro -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tgpro

# Unbuffered output so logs appear immediately.
Environment=PYTHONUNBUFFERED=1

# Give live-stream connections time to close cleanly on stop/restart.
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
