# Copy this file to ".env" and fill in the values.

# The SAME Neon connection string your website uses.
# Get it from: v0 project -> Settings (top right) -> Vars -> DATABASE_URL
# It looks like: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: a stable id for this machine so the dashboard can identify it.
# If you run more than one agent, give each a different id.
AGENT_ID=agent-main

# Optional: how often (seconds) to poll for new jobs. Default 3.
AGENT_POLL_SECONDS=3
