# ============================================================================
# iamhear VPS Configuration Template (500+ Account Setup)
# Copy this to .env and fill in your values
# ============================================================================

# ========== DATABASE (REQUIRED) ==========
# Get from Neon Dashboard → Project → Connection String
# Must include ?sslmode=require at the end
# Format: postgresql://user:password@ep-xxxxxxxxxxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxxxxxxxxx.neon.tech/dbname?sslmode=require

# ========== TG-LION (auto-buy + auto-provision accounts) ==========
# From your tg-lion.net dashboard. Required to buy numbers and read login codes.
TGLION_API_KEY=your_tglion_api_key
TGLION_USER_ID=your_tglion_user_id
# Optional: override the API base. Use the APEX domain (the www. host serves
# the docs HTML page, not the JSON API). Defaults to https://tg-lion.net
# TGLION_BASE_URL=https://tg-lion.net

# The NEW two-step (2FA) password we set on EVERY account bought via tg-lion so
# they stay under your control. One fixed password across all bought accounts.
# REQUIRED for auto-provisioning to complete.
TGLION_NEW_2FA_PASSWORD=choose-a-strong-password

# Shared Telegram app credential used to sign every bought account in over
# MTProto. OPTIONAL: if left unset we use Telegram Desktop's public credentials,
# so provisioning works out-of-the-box and never touches my.telegram.org.
# Set these only if you want to use your own app from my.telegram.org.
# TGLION_API_ID=2040
# TGLION_API_HASH=b18441a1ff607e10a989891a5462e627

# How long to wait for Telegram to deliver a login code via tg-lion. Telegram
# SMS fallbacks can be slow, so we poll: ATTEMPTS * DELAY seconds total.
# Defaults: 40 attempts x 5s = ~200s. Raise ATTEMPTS if codes arrive late.
TGLION_CODE_ATTEMPTS=40
TGLION_CODE_DELAY=5

# ========== PROFILE THROTTLE (CRITICAL - Telegram has strict rate limits) ==========
# How many profile update jobs (name/username/photo) run concurrently
# WARNING: Never set > 3. Telegram WILL rate-limit heavily if you exceed this.
# For 500+ accounts: use 1-2 to stay under Telegram's radar
AGENT_PROFILE_CONCURRENCY=2

# Delay in seconds between each profile job execution
# Higher = safer from Telegram floods, but slower overall
# For 500+ accounts: 5-10 seconds recommended
AGENT_PROFILE_DELAY_SECONDS=5

# ========== FLOOD RESILIENCE ==========
# Max times a job is rescheduled after Telegram rate-limit before permanently failing
# Higher = more likely all accounts eventually succeed, but takes longer
# For 500+ accounts: 25-50 (25 is safe default)
AGENT_MAX_FLOOD_RETRIES=25

# ========== WORKER SCALING ==========
# Number of async worker coroutines to spawn
# Tune to your CPU cores: 4-core VPS → 4 workers, 8-core → 6-8 workers
# RAM matters too: each worker consumes memory, so monitor usage
AGENT_WORKERS=4

# Jobs claimed per poll cycle (batch size)
# Larger = more throughput but higher burst load on database
# Keep between 10-30, never exceed 50
BATCH_SIZE=20

# How often (seconds) to poll database for new jobs
# Lower = faster detection but more database queries
# 1-3 seconds is typical
AGENT_POLL_SECONDS=2

# ========== DATABASE POOL (agent-stall / socket.send() fix) ==========
# The agent reuses warm pooled DB connections instead of opening a fresh TLS
# connection per query. Without this, a burst of ~100 finishing jobs froze the
# event loop for seconds, which broke pytgcalls sockets ("socket.send() raised
# exception"), stalled the agent, and dropped bots from the live stream. Leave
# these at the defaults unless you know you need more.
AGENT_DB_POOL_MIN=2
AGENT_DB_POOL_MAX=10
# Threads for off-loop DB writes (asyncio.to_thread). Absorbs a burst of
# finishing jobs; threads mostly wait on the pool, so this is cheap.
AGENT_DB_THREAD_WORKERS=24

# ========== SHARDING (the real fix for 500+ bots — multi-process) ==========
# Every userbot holds a persistent WebRTC live-stream connection. Hundreds of
# them in ONE process/event loop means a momentary stall starves the keepalives
# and Telegram drops everyone ("join then drop after a few min"). The fix is
# horizontal: run several worker PROCESSES, each on its own CPU core with its own
# event loop, each owning a SLICE of the bots. An account belongs to shard i when
# (account_id % SHARD_COUNT == i), so every bot lives in exactly one process.
# Fan-out actions (view/react/leave-all) are enqueued once; shard 0 copies each
# one per shard so they still reach every bot.
#
# Run everything via the supervisor (it spawns + auto-restarts the shards):
#     python -m agent.supervisor
#
# On an 8-core VPS, 7 leaves one core for the OS + supervisor + DB driver.
LS_WORKER_SHARDS=7
# Warn-only ceiling per shard (never rejects bots). 500 bots / 7 ≈ 72 each; if a
# shard exceeds this, the worker logs a hint to add shards or another VPS.
LS_SOFT_MAX_PER_SHARD=70
# Seconds to wait before restarting a crashed shard (guards against crash loops).
LS_SHARD_RESTART_BACKOFF=5
# Single-process mode (no supervisor): keep LS_WORKER_SHARDS=1 and run
# `python -m agent.worker` — identical to the classic behavior.

# ========== LIVE STREAM JOIN THROTTLE (CRITICAL for 500-1000 bots) ==========
# Joining a group call is MUCH heavier than a normal API call — each join opens
# a full WebRTC/NTgCalls connection. Firing hundreds at once floods the process
# and Telegram, so most bots silently fail to appear in the stream. These knobs
# trickle joins in smoothly so even 1000 bots join reliably and look like real
# viewers arriving.
#
# How many group-call joins run CONCURRENTLY. Higher = faster but heavier on
# CPU/RAM and more likely to hit Telegram join limits. 6-12 is a good range for
# a typical VPS; raise cautiously only if joins stay reliable.
AGENT_JOIN_CONCURRENCY=8

# Base seconds of jittered gap before each join takes a concurrency slot, so
# bots arrive staggered instead of in one spike. 0.3-0.7 works well.
AGENT_JOIN_STAGGER_SECONDS=0.4

# How many times ONE join retries a transient (non-flood) network/call hiccup
# before that bot's join is marked failed. Telegram rate-limits (FloodWait) are
# handled separately by AGENT_MAX_FLOOD_RETRIES (durable reschedule).
AGENT_JOIN_RETRY_ATTEMPTS=3

# ========== LIVE-STREAM KEEP-ALIVE ("mass drop" fix) ==========
# How often (seconds) the agent checks that every bot which SHOULD be in the
# live stream still is, and rejoins any that dropped — through the same throttle
# so even a mass-drop (e.g. a server-side call restart kicking hundreds at once)
# recovers smoothly instead of spiking. Lower = faster recovery. 15s is a good
# balance and is near-free when everyone is healthy.
AGENT_RECONCILE_SECONDS=15

# A dropped bot is NEVER abandoned: as long as the agent runs and the host's
# stream is live, it is rejoined forever and only leaves when YOU stop the task.
# The agent only stops tracking a chat's bots after it has confirmed the live
# stream is REALLY gone this many times IN A ROW (each check is one reconcile
# sweep). This guards against a single transient "stream gone" misread wrongly
# kicking hundreds of bots out. 4 x 15s ≈ only give up ~60s after a real end.
# Raise it if you ever see bots released while the stream was actually still up.
AGENT_STREAM_GONE_CONFIRMATIONS=4

# Exponential backoff (seconds) between failed rejoin attempts for a SINGLE bot:
# BASE, then 2x, 4x ... up to MAX. This is what stops a mass recovery from turning
# into a re-play() storm — and that storm, on one shared event loop, is what
# starves the WebRTC keepalives and makes bots "join then drop". A bot is still
# never abandoned; it just retries more gently. First-time drops retry instantly.
AGENT_REJOIN_BACKOFF_BASE=10
AGENT_REJOIN_BACKOFF_MAX=120

# ========== LOGGING ==========
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========== AGENT IDENTITY ==========
# Optional: custom agent ID for identification in logs/dashboard
# If running multiple VPS workers, give each a different ID
AGENT_ID=agent-main

# Optional: custom hostname for this VPS (auto-detected if omitted)
# AGENT_HOSTNAME=vps-worker-1
