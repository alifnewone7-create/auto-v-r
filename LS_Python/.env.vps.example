# ============================================================================
# iamhear — VPS production config (.env.vps)
# The agent loads THIS file first when present, then falls back to .env.
# Copy to your VPS, fill in the REQUIRED values, keep it next to requirements.txt
# inside the LS_Python folder. NEVER commit real secrets to git.
# ============================================================================

# ========== DATABASE (REQUIRED) ==========
# Same Neon connection string the website uses.
# v0 project → Settings (top right) → Vars → DATABASE_URL
# Must end with ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxxxxxxxxx.neon.tech/dbname?sslmode=require

# ========== TG-LION (auto-buy + auto-provision accounts) ==========
# Required only if you buy/provision numbers through tg-lion from the website.
TGLION_API_KEY=your_tglion_api_key
TGLION_USER_ID=your_tglion_user_id
# TGLION_BASE_URL=https://tg-lion.net

# The single 2FA password set on EVERY tg-lion account so they stay under your
# control. REQUIRED for auto-provisioning to finish.
TGLION_NEW_2FA_PASSWORD=choose-a-strong-password

# Optional: your own Telegram app creds. Leave unset to use the built-in
# Telegram Desktop public credentials (works out of the box).
# TGLION_API_ID=2040
# TGLION_API_HASH=b18441a1ff607e10a989891a5462e627

# How long to wait for tg-lion to deliver a login code (ATTEMPTS * DELAY sec).
TGLION_CODE_ATTEMPTS=40
TGLION_CODE_DELAY=5

# ========== WORKER SCALING (tune to your VPS) ==========
# Async worker coroutines. 4-core VPS -> 4, 8-core -> 6-8.
AGENT_WORKERS=4
# Jobs claimed & run concurrently per loop. For big live-stream joins keep high
# so all bots join in one parallel batch.
AGENT_BATCH_SIZE=100
# How often (seconds) to poll the DB for new jobs.
AGENT_POLL_SECONDS=2

# ========== PROFILE THROTTLE (Telegram rate limits — keep low!) ==========
# Never exceed 3. For 500+ accounts use 1-2.
AGENT_PROFILE_CONCURRENCY=2
# Seconds between each profile job.
AGENT_PROFILE_DELAY_SECONDS=5

# ========== FLOOD RESILIENCE ==========
# Times a job is retried after a Telegram FloodWait before failing.
AGENT_MAX_FLOOD_RETRIES=25

# ========== LIVE VIEW / REACTION PACING (optional) ==========
# AGENT_VIEW_POLL_SECONDS=5
# AGENT_VIEW_MAX_BACKFILL=30
# AGENT_VIEW_SPREAD_SECONDS=45

# ========== LOGGING / IDENTITY ==========
LOG_LEVEL=INFO
# Give each VPS a unique id if you run more than one worker.
AGENT_ID=vps-main
# AGENT_HOSTNAME=vps-worker-1
