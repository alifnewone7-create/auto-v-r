# ---------------------------------------------------------------------------
# Python Agent configuration
# Ekhoni file-ta LOCAL PC ebong VPS — duitatei kaj kore. Run: python -m agent.worker
# (VPS-e chaile alada override .env.vps rakho — eta por-e load hoye jeet-e.)
# ---------------------------------------------------------------------------
# Neon Postgres connection (job-queue database). Eta website-er sathe SHARED.
# Vercel project-er Vars section-e POSTGRES_URL / DATABASE_URL ei value-i thake.
DATABASE_URL=postgresql://neondb_owner:npg_6YBbTrS7LyuQ@ep-withered-river-aos3xjnb-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Ei agent-er ekta unique nam (multiple PC/VPS cholale alada alada din).
AGENT_ID=local-agent-1

# Koto second por por jobs table poll korbe.
AGENT_POLL_SECONDS=3

# Prottek poll-e koto job ek shathe claim + concurrently run korbe. BORO
# live-stream join-er jonno beshi rakhle shob bot druto pick hoy (asol pacing
# niche AGENT_JOIN_* diye hoy). 500-1000 account-er jonno 100 bhalo default.
AGENT_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# DATABASE POOL (agent stuck / "socket.send() raised exception" fix)
# ---------------------------------------------------------------------------
# Age prottek DB call ekta notun connection kholto (prottekbar full TLS
# handshake) — 100 job ek shathe sesh hole event loop kayek second freeze hoto,
# ar tokhon pytgcalls-er socket noshto hoye "socket.send() raised exception"
# ashto + bot live theke drop hoto. Ekhon warm pooled connection reuse hoy, tai
# prottek call ~1-5ms, loop ar freeze hoy na. Beshirbhag khetre change korar
# dorkar nei.
AGENT_DB_POOL_MIN=2
AGENT_DB_POOL_MAX=10
# Off-loop DB kaj-er jonno koto thread. 100 job sesh howar burst absorb korte
# jotesto; era beshirbhag shomoy pool-er jonno wait kore, tai halka.
AGENT_DB_THREAD_WORKERS=24

# ---------------------------------------------------------------------------
# TG-LION (auto-buy + auto-provision)
# ---------------------------------------------------------------------------
# tg-lion.net dashboard theke ei duita boshao (getCode kaj korte lagbe).
TGLION_API_KEY=REPLACE_WITH_YOUR_TGLION_API_KEY
TGLION_USER_ID=REPLACE_WITH_YOUR_TGLION_USER_ID

# API base (default apex domain; www. version docs HTML dey, JSON noy).
TGLION_BASE_URL=https://tg-lion.net

# Notun two-step (2FA) password - SOB kena account e eita set hobe.
# Eta ekta fixed strong password; nirapode songrokhon koro.
TGLION_NEW_2FA_PASSWORD=Lion#Secure2FA_9x7Qw2

# Login code delivery-r jonno koto khon wait korbe (ATTEMPTS * DELAY second).
TGLION_CODE_ATTEMPTS=40
TGLION_CODE_DELAY=5

# Optional: nijer Telegram app cred (my.telegram.org). Comment thakle Telegram
# Desktop-er built-in public credentials use hoy — out of the box kaj kore.
# TGLION_API_ID=2040
# TGLION_API_HASH=b18441a1ff607e10a989891a5462e627

# Bulk kena-r pace: prottek number kena-r por gap, ar transient error-e retry.
AGENT_BUY_PACING_SECONDS=8
AGENT_BUY_RETRY_ATTEMPTS=4
AGENT_BUY_RETRY_DELAY=15

# ---------------------------------------------------------------------------
# LIVE STREAM JOIN THROTTLE (500-1000 bot-er jonno CRITICAL)
# ---------------------------------------------------------------------------
# Group call-e join kora normal API call-er cheye onek BHARI — prottek join
# ekta full WebRTC/NTgCalls connection khole. Ek shathe shob-gulo join korle
# process + Telegram dubey jay, tai beshirbhag bot chup-chap join hoy na. Ei
# knob-gulo join-gulo smooth vabe trickle kore, jate 1000 bot-o thik moto join
# kore ar asol viewer-er moto ashe.
#
# Ekshathe koto-ta join concurrently cholbe. Typical VPS-e 6-12 bhalo; join
# reliable thakle sabdhane baraite paro.
AGENT_JOIN_CONCURRENCY=8
# Prottek join slot newar age chhoto jittered gap (staggered arrival).
AGENT_JOIN_STAGGER_SECONDS=0.4
# EKTA join transient (non-flood) network/call hiccup-e koto bar retry korbe.
AGENT_JOIN_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# LIVE-STREAM KEEP-ALIVE ("300 join korlo, 270 hotat chole gelo" fix)
# ---------------------------------------------------------------------------
# Koto shekonde ekbar check hobe je jara live-e thakar kotha tara ekhono ache
# kina — je bot drop hoyeche take same throttle diye rejoin koray. Mass-drop
# hole eta kayek shekondei shobaike phiriye ane (spike na kore). 15s bhalo
# default; shobai healthy thakle prayo free.
AGENT_RECONCILE_SECONDS=15

# ---------------------------------------------------------------------------
# PROFILE THROTTLE (Telegram-er strict rate limit — KOM rakho!)
# ---------------------------------------------------------------------------
# Koto-ta profile (name/username/photo) job ekshathe cholbe. KOKHONO 3-er beshi
# na. 500+ account-er jonno 1-2 use koro.
AGENT_PROFILE_CONCURRENCY=2
# Prottek profile job-er majhe delay (beshi = flood theke nirapod).
AGENT_PROFILE_DELAY_SECONDS=5

# ---------------------------------------------------------------------------
# FLOOD RESILIENCE
# ---------------------------------------------------------------------------
# Telegram FloodWait-er por ekta job koto bar reschedule hobe fail howar age.
# 500+ account-er jonno 25-50 rakhle prai shob eventually succeed kore.
AGENT_MAX_FLOOD_RETRIES=25

# ---------------------------------------------------------------------------
# LIVE VIEW / REACTION PACING (optional — bhalo default ache)
# ---------------------------------------------------------------------------
AGENT_VIEW_POLL_SECONDS=5
AGENT_VIEW_MAX_BACKFILL=30
AGENT_VIEW_SPREAD_SECONDS=45
AGENT_REACT_FAST_SECONDS=30
AGENT_REACT_MEDIUM_SECONDS=120
AGENT_REACT_SLOW_SECONDS=360
